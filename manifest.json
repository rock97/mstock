{
  "manifest_version": 3,
  "name": "股市速览 - A股/港股/美股行情",
  "version": "1.0.0",
  "description": "查看A股、港股、美股的实时行情、分时图与日/周/月K线及分钟K线，支持自选股管理与股票搜索。",
  "minimum_chrome_version": "100",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "股市速览",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://qt.gtimg.cn/*",
    "https://web.ifzq.gtimg.cn/*",
    "https://ifzq.gtimg.cn/*",
    "https://smartbox.gtimg.cn/*"
  ]
}
